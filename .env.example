# Copy to .env and fill in. Never commit .env.
# LLM provider: openrouter | anthropic | bedrock. Unset = ANTHROPIC, then Bedrock, then OpenRouter.
LLM_PROVIDER=openrouter
# OpenRouter: agent LLM calls (when LLM_PROVIDER=openrouter) and Jev voting (Stage 3).
OPENROUTER_API_KEY=
# Model per agent: premium (demo, ~$0.70-1 per run) | cheap (dev, a few cents) | free ($0, 50 requests/day).
COUNCIL_PROFILE=cheap
# Optional per-agent override, e.g. MODEL_BEAR=anthropic/claude-opus-5.5
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=
# Effort for agent calls: low | medium | high. Low keeps votes under the per-call timeout.
CLAUDE_EFFORT=low
# Seconds per LLM call (OpenRouter backups share this budget).
LLM_TIMEOUT_S=25
# 1 = never touch the network: runs are served from runs/{event}.json recordings (demo with Wi-Fi off).
COUNCIL_OFFLINE=0
# 1 = /council/stream replays mocks/council_run.json instead of calling agents (no keys needed).
COUNCIL_MOCK=0
# Debate rounds are chosen per council in the builder (1 or 2); there is no env setting.

# Stage 3A: calibrated votes from TypeSafe Jev (api.typesafe.ai). Empty = LLM votes. JEV=0 turns it off.
TYPESAFE_API_KEY=

# Compliance layer: Bedrock guardrail on every message and brief line. Create it with
# python scripts/create_guardrail.py (uses AWS_REGION + AWS credentials above). Empty = off.
GUARDRAIL_ID=
GUARDRAIL_VERSION=
# GUARDRAIL=0 switches the guardrail off for every run (the UI also has a per-run toggle).

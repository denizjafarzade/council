# Copy to .env and fill in. Never commit .env.
# LLM: pick one provider (call_llm tries ANTHROPIC first, then Bedrock).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=
# Voting (Stage 3): Jev via OpenRouter
OPENROUTER_API_KEY=
# Claude effort for agent calls: low | medium | high. Low keeps votes under the 25 s per-call timeout.
CLAUDE_EFFORT=low
# 1 = /council/stream replays mocks/council_run.json instead of calling agents (no keys needed).
COUNCIL_MOCK=0

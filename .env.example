# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# premium (demo, ~$0.70-1 per run) | cheap (dev, a few cents) | free ($0, 50 requests/day)
COUNCIL_PROFILE=cheap
# Seconds per LLM call before falling back to the next model.
LLM_TIMEOUT_S=25
# Optional per-agent override, e.g. MODEL_BEAR=anthropic/claude-opus-5.5
